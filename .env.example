# =============================================================================
# Teron — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — only .env.example is tracked in git.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/teron?schema=public"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="your-session-secret-min-32-chars-long"

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your-posthog-project-token"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Chain / Wallet ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"
NEXT_PUBLIC_BNB_RPC_URL="https://bsc-dataseed1.binance.org"
NEXT_PUBLIC_BNB_CHAIN_ID="56"
COLD_WALLET_ADDRESS="0xYourColdWalletAddress"

# --- Admin ---
# Comma-separated list of wallet addresses with admin access
ADMIN_WALLET_ADDRESSES="0xAdminWallet1,0xAdminWallet2"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# --- Resend (Email) ---
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@teron.io"

# --- Contract Verification (Etherscan V2 API) ---
# Get a FREE Etherscan API key from https://etherscan.io/myapikey
# The V2 API uses this key for all chains including BSC.
ETHERSCAN_API_KEY="your-etherscan-api-key"
BSCSCAN_API_KEY="your-bscscan-api-key"

# --- Email (Gmail SMTP) ---
EMAIL_USER="your-email@gmail.com"
EMAIL_APP_PASSWORD="your-gmail-app-password"
